# Copy to .env and fill in what you use. Nothing here is required for an offline run.

# LLM (pick one in config/studio.yaml -> llm.provider)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=text-embedding-004
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional override of llm.provider without editing YAML
# AVS_LLM_PROVIDER=offline

# YouTube Data API v3 (see README -> YouTube API setup)
YOUTUBE_CLIENT_SECRETS=secrets/client_secret.json
YOUTUBE_TOKEN_FILE=secrets/youtube_token.json

# Kaggle datasets (optional, data_story)
KAGGLE_USERNAME=
KAGGLE_KEY=

# Extra format plugin folders, os.pathsep separated (optional)
AVS_EXTRA_FORMATS=
